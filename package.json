{
  "name": "peloton-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Peloton workout data - diabetes management integration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "peloton-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start:http": "HTTP_MODE=true node dist/index.js",
    "capture-oauth": "node scripts/capture-oauth-and-update.mjs",
    "setup:playwright": "playwright install chromium"
  },
  "keywords": [
    "mcp",
    "peloton",
    "fitness",
    "diabetes",
    "t1d"
  ],
  "author": "Cyrus Jalili Khiabani",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.13",
    "@libsql/client": "^0.17.2",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.7.2",
    "dotenv": "^17.4.0",
    "hono": "^4.12.10",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "nock": "^14.0.11",
    "playwright": "^1.61.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^4.0.18"
  }
}
