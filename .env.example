# ---------------------------------------------------------------------------
# MCP server / remote connector (src/http-server.ts)
# ---------------------------------------------------------------------------

# REQUIRED. Bearer token for /mcp. The server exits on boot if this is unset.
# Returned as the access_token by the OAuth /token endpoint. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# REQUIRED for the Claude remote-connector OAuth flow. Enter these same values
# as the connector's OAuth client ID / client secret.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# REQUIRED for the OAuth flow. Comma-separated list of redirect URIs, exact-match
# (no wildcards, no prefix matching). If empty, /authorize rejects every request.
ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Public HTTP port. Default: 8080 (must match internal_port in fly.toml).
# PORT=8080

# ---------------------------------------------------------------------------
# Private admin listener (manual Peloton token override)
# ---------------------------------------------------------------------------

# Secret for POST /update-peloton-token on the private admin listener. If unset,
# the admin listener is not started. Must differ from MCP_AUTH_TOKEN (the server
# refuses to start otherwise). Also read by `npm run capture-oauth`.
# Reach the listener with: fly proxy 9091:9091 -a peloton-mcp-server
PELOTON_TOKEN_UPDATE_SECRET=

# Admin listener port. Default: 9091.
# ADMIN_PORT=9091

# Admin listener bind address. Default: fly-local-6pn when FLY_APP_NAME is set
# (Fly injects it), otherwise 127.0.0.1. Do not expose this port in fly.toml.
# ADMIN_HOST=127.0.0.1

# Only for `npm run capture-oauth`: override the admin URL it posts to.
# Default: http://localhost:9091/update-peloton-token (i.e. via fly proxy).
# PELOTON_TOKEN_UPDATE_URL=

# ---------------------------------------------------------------------------
# Database (src/db/database.ts) - libSQL / Turso
# ---------------------------------------------------------------------------

# Stores workouts, glucose correlations, and the persisted Peloton auth token.
# Without it, DB-backed features are unavailable and tokens live in memory only.
# Local dev can use a libSQL file URL instead, e.g. file:./data/peloton.db
TURSO_DATABASE_URL=libsql://your-database.turso.io

# Needed for remote Turso databases; not needed for file: URLs.
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Peloton credentials
# ---------------------------------------------------------------------------

# Used for auto-login (password login may be blocked by Cloudflare; prefer the
# OAuth bootstrap) and by `npm run capture-oauth`.
PELOTON_USERNAME=your_username
PELOTON_PASSWORD=your_password

# Optional: override Auth0 client_id if tokens were issued for a different client
# PELOTON_AUTH_CLIENT_ID=WVoJxVDdPoFx4RNewvvg6ch2mZ7bwnsM

# Optional fallbacks: access JWT pasted from the browser (peloton_refresh_token also needs a refresh_token)
# and the Peloton session cookie value (peloton_session_id=...).
# PELOTON_BEARER_TOKEN=eyJ...
# PELOTON_SESSION_COOKIE=
