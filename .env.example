# Peloton credentials (password login may be blocked by Cloudflare; prefer OAuth bootstrap below)
PELOTON_USERNAME=your_username
PELOTON_PASSWORD=your_password

# Optional: override Auth0 client_id if tokens were issued for a different client
# PELOTON_AUTH_CLIENT_ID=WVoJxVDdPoFx4RNewvvg6ch2mZ7bwnsM

# One-time alternative: paste access JWT from browser (peloton_refresh_token also needs refresh_token)
# PELOTON_BEARER_TOKEN=eyJ...

# OAuth redirect allowlist for remote MCP connectors (comma-separated, exact match)
# ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Secret for /update-peloton-token on the private admin listener (port 9091, Fly 6PN only).
# Must differ from MCP_AUTH_TOKEN. Reach it via: fly proxy 9091:9091 -a peloton-mcp-server
# PELOTON_TOKEN_UPDATE_SECRET=

# Database path for storing workouts and glucose correlations
PELOTON_DB_PATH=./data/peloton.db
